@article{mangalamMultiplicativecascadeDynamicsSupports2020,
  title = {Multiplicative-Cascade Dynamics Supports Whole-Body Coordination for Perception via Effortful Touch},
  author = {Mangalam, Madhur and Kelty-Stephen, Damian G.},
