@article{andersonDynamicOptimizationHuman2001,
  title = {Dynamic Optimization of Human Walking},
  author = {Anderson, F. C. and Pandy, M. G.},
  date = {2001-10},
  journaltitle = {Journal of Biomechanical Engineering},
  shortjournal = {J Biomech Eng},
  volume = {123},
