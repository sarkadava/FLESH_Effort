@article{goodwynNoTitleFound2000,
  title = {[{{No}} Title Found]},
  author = {Goodwyn, Susan W. and Acredolo, Linda P. and Brown, Catherine A.},
  date = {2000},
  journaltitle = {Journal of Nonverbal Behavior},
  volume = {24},
