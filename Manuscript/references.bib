@article{greenfieldCoordinatedRhythmsAnimal2023,
  title = {Coordinated Rhythms in Animal Species, Including Humans: {{Entrainment}} from Bushcricket Chorusing to the Philharmonic Orchestra},
  shorttitle = {Coordinated Rhythms in Animal Species, Including Humans},
  author = {Greenfield, Michael D. and Merker, Bjorn},
  date = {2023-10-01},
  journaltitle = {Neuroscience \& Biobehavioral Reviews},
  shortjournal = {Neuroscience \& Biobehavioral Reviews},
  volume = {153},
  pages = {105382},
  issn = {0149-7634},
  doi = {10.1016/j.neubiorev.2023.105382},
  url = {https://www.sciencedirect.com/science/article/pii/S0149763423003512},
  urldate = {2023-10-06},
  abstract = {Coordinated group displays featuring precise entrainment of rhythmic behavior between neighbors occur not only in human music, dance and drill, but in the acoustic or optical signaling of a number of species of arthropods and anurans. In this review we describe the mechanisms of phase resetting and phase and tempo adjustments that allow the periodic output of signaling individuals to be aligned in synchronized rhythmic group displays. These mechanisms are well described in some of the synchronizing arthropod species, in which conspecific signals reset an individual’s endogenous output oscillators in such a way that the joint rhythmic signals are locked in phase. Some of these species are capable of mutually adjusting both the phase and tempo of their rhythmic signaling, thereby achieving what is called perfect synchrony, a capacity which otherwise is found only in humans. We discuss this disjoint phylogenetic distribution of inter-individual rhythmic entrainment in the context of the functions such entrainment might perform in the various species concerned, and the adaptive circumstances in which it might evolve.},
  keywords = {Central pattern generator,CNS oscillator,Coupled oscillator,Isochrony,Musicality,Signal interactions},
  file = {C\:\\Users\\kadava\\Zotero\\storage\\PV5YMDFG\\Greenfield and Merker - 2023 - Coordinated rhythms in animal species, including h.pdf;C\:\\Users\\kadava\\Zotero\\storage\\P69HZQ7W\\S0149763423003512.html}
}

@article{greenfieldSynchronyRhythmInteraction2021,
  title = {Synchrony and Rhythm Interaction: From the Brain to Behavioural Ecology},
  shorttitle = {Synchrony and Rhythm Interaction},
  author = {Greenfield, Michael D. and Honing, Henkjan and Kotz, Sonja A. and Ravignani, Andrea},
  date = {2021-10-11},
  journaltitle = {Philosophical Transactions of the Royal Society B: Biological Sciences},
  shortjournal = {Phil. Trans. R. Soc. B},
  volume = {376},
  number = {1835},
  pages = {20200324},
  issn = {0962-8436, 1471-2970},
  doi = {10.1098/rstb.2020.0324},
  url = {https://royalsocietypublishing.org/doi/10.1098/rstb.2020.0324},
  urldate = {2023-05-03},
  abstract = {This theme issue assembles current studies that ask how and why precise synchronization and related forms of rhythm interaction are expressed in a wide range of behaviour. The studies cover human activity, with an emphasis on music, and social behaviour, reproduction and communication in non-human animals. In most cases, the temporally aligned rhythms have short—from several seconds down to a fraction of a second—periods and are regulated by central nervous system pacemakers, but interactions involving rhythms that are 24 h or longer and originate in biological clocks also occur. Across this spectrum of activities, species and time scales, empirical work and modelling suggest that synchrony arises from a limited number of coupled-oscillator mechanisms with which individuals mutually entrain. Phylogenetic distribution of these common mechanisms points towards convergent evolution. Studies of animal communication indicate that many synchronous interactions between the signals of neighbouring individuals are specifically favoured by selection. However, synchronous displays are often emergent properties of entrainment between signalling individuals, and in some situations, the very signallers who produce a display might not gain any benefit from the collective timing of their production.             This article is part of the theme issue ‘Synchrony and rhythm interaction: from the brain to behavioural ecology’.},
  langid = {english},
  file = {C:\Users\kadava\Zotero\storage\GJ6BAU6S\Pouw_etal_2021_Multilevel rhythms in multimodal communication.pdf}
}

@article{grimmeLimbSpeechMotor2011,
  title = {Limb versus {{Speech Motor Control}}: {{A Conceptual Review}}},
  shorttitle = {Limb versus {{Speech Motor Control}}},
  author = {Grimme, Britta and Fuchs, Susanne and Perrier, Pascal and Schöner, Gregor},
  date = {2011-01-01},
  journaltitle = {Motor Control},
  volume = {15},
  number = {1},
  pages = {5--33},
  publisher = {Human Kinetics, Inc.},
  issn = {1087-1640, 1543-2696},
  doi = {10.1123/mcj.15.1.5},
  url = {https://journals.humankinetics.com/view/journals/mcj/15/1/article-p5.xml},
  urldate = {2023-01-26},
  abstract = {This paper presents a comparative conceptual review of speech and limb motor control. Speech is essentially cognitive in nature and constrained by the rules of language, while limb movement is often oriented to physical objects. We discuss the issue of intrinsic vs. extrinsic variables underlying the representations of motor goals as well as whether motor goals specify terminal postures or entire trajectories. Timing and coordination is recognized as an area of strong interchange between the two domains. Although coordination among different motor acts within a sequence and coarticulation are central to speech motor control, they have received only limited attention in manipulatory movements. The biomechanics of speech production is characterized by the presence of soft tissue, a variable number of degrees of freedom, and the challenges of high rates of production, while limb movements deal more typically with inertial constraints from manipulated objects. This comparative review thus leads us to identify many strands of thinking that are shared across the two domains, but also points us to issues on which approaches in the two domains differ. We conclude that conceptual interchange between the fields of limb and speech motor control has been useful in the past and promises continued benefit.},
  langid = {american},
  file = {C:\Users\kadava\Zotero\storage\TPQWI4KM\Grimme et al. - 2011 - Limb versus Speech Motor Control A Conceptual Rev.pdf}
}

@article{grodwohlEarlyRiseSpread2023,
