@article{melnikoffBayesianismWishfulThinking2024,
  title = {Bayesianism and Wishful Thinking Are Compatible},
  author = {Melnikoff, David E. and Strohminger, Nina},
  date = {2024-02-23},
  journaltitle = {Nature Human Behaviour},
  shortjournal = {Nat Hum Behav},
  pages = {1--10},
  publisher = {Nature Publishing Group},
  issn = {2397-3374},
  doi = {10.1038/s41562-024-01819-6},
  url = {https://www.nature.com/articles/s41562-024-01819-6},
  urldate = {2024-03-20},
  abstract = {Bayesian principles show up across many domains of human cognition, but wishful thinking—where beliefs are updated in the direction of desired outcomes rather than what the evidence implies—seems to threaten the universality of Bayesian approaches to the mind. In this Article, we show that Bayesian optimality and wishful thinking are, despite first appearances, compatible. The setting of opposing goals can cause two groups of people with identical prior beliefs to reach opposite conclusions about the same evidence through fully Bayesian calculations. We show that this is possible because, when people set goals, they receive privileged information in the form of affective experiences, and this information systematically supports goal-consistent conclusions. We ground this idea in a formal, Bayesian model in which affective prediction errors drive wishful thinking. We obtain empirical support for our model across five studies.},
  langid = {english},
  keywords = {Business and management,Human behaviour},
  file = {C:\Users\kadava\Zotero\storage\CJTWXKG7\Melnikoff and Strohminger - 2024 - Bayesianism and wishful thinking are compatible.pdf}
}

