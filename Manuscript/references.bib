@article{treffnerIntentionalAttentionalDynamics2002,
  title = {Intentional and Attentional Dynamics of Speech-Hand Coordination},
  author = {Treffner, Paul and Peter, Mira},
  date = {2002},
  journaltitle = {Human Movement Science},
  volume = {21},
  number = {5--6},
  pages = {641--697},
  publisher = {Elsevier Science},
  location = {Netherlands},
  issn = {1872-7646},
  doi = {10.1016/S0167-9457(02)00178-1},
  abstract = {Interest is rapidly growing in the hypothesis that natural language emerged from a more primitive set of linguistic acts based primarily on manual activity and hand gestures. Increasingly, researchers are investigating how hemispheric asymmetries are related to attentional and manual asymmetries. Both speech perception and production have origins in the dynamical generative movements of the vocal tract known as articulatory gestures. Thus, the notion of a "gesture" can be extended to both hand movements and speech articulation. The generative actions of the hands and vocal tract can therefore provide a basis for the perception of linguistic acts. Such gestures are best described using the methods of dynamical systems analysis since both perception and production can be described using the same commensurate language. Experiments were conducted using a phase transition paradigm to examine the coordination of speech-hand gestures in both left- and right-handed individuals. Results address coordination, hand, lateralization, focus of attention, and how dynamical constraints provide a foundation for human communicative acts. Predictions from the asymmetric HKB equation confirm the attentional basis of functional asymmetry. (PsycInfo Database Record (c) 2020 APA, all rights reserved)},
  keywords = {Articulation (Speech),Attention,Gestures,Hand (Anatomy),Lateral Dominance,Linguistics,Motor Coordination,Speech Perception},
  file = {C:\Users\kadava\Zotero\storage\FIK8MJBQ\2003-03301-007.html}
}

