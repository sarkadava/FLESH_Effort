@article{hondaVariousLaryngealMechanisms2005,
  title = {Various Laryngeal Mechanisms in Controlling the Voice Fundamental Frequency},
  author = {Honda, Kiyoshi},
  date = {2005-08-13},
  journaltitle = {The Journal of the Acoustical Society of America},
  shortjournal = {J. Acoust. Soc. Am.},
  volume = {84},
  number = {S1},
  pages = {S82},
  issn = {0001-4966},
  doi = {10.1121/1.2026504},
  url = {https://doi.org/10.1121/1.2026504},
  urldate = {2025-10-20},
  abstract = {It is generally believed that the muscular control for the voice fundamental frequency (F0) is performed mainly by the cricothyroid. However, it has been noted in several studies that the whole F0 range produced by humans cannot be obtained by cricothyroid activity alone. This study reports variations in the EMG activity of some laryngeal muscles associated with F0 variations in word utterances and the speculated mechanisms of FO control by these muscles. First, the cricopharyngeus (CP) exhibits an inverse correlation with F0, suggesting that this muscle can rotate the cricoid cartilage inversely. Second, the lateral cricoarytenoid (LCA) shows the highest correlation with F0, indicating its function in adjusting the effective length of the vocal fold vibration. Third, the oblique part of the cricothyroid (CT) has a higher correlation with F0 than the rectal part, and it is speculated that the rectal part produces the fast F0 change associated with laryngeal articulation and that the oblique part functions to expand the F0 range independently of articulatory gestures. These speculated mechanisms explain the observed nonlinear relation between vocal fold length and F0. [A part of this work was done at Haskins Laboratories, New Haven, CT.]}
}

