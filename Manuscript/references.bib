@article{kiddSourcesConsequencesIndividual2023,
  title = {The Sources and Consequences of Individual Differences in Statistical Learning for Language Development},
  author = {Kidd, Evan and Arciuli, Joanne and Christiansen, Morten H. and Smithson, Michael},
  date = {2023-04-01},
  journaltitle = {Cognitive Development},
  shortjournal = {Cognitive Development},
