  keywords = {an automated method,interpersonal coordination,Nonverbal Behavior,Spectrum Analysis,synchrony,Wavelet Transform}
}

@article{fusaroliDialogicallyExtendedMind2014,
  title = {The Dialogically Extended Mind: {{Language}} as Skilful Intersubjective Engagement},
  shorttitle = {The Dialogically Extended Mind},
  author = {Fusaroli, Riccardo and Gangopadhyay, Nivedita and Tylén, Kristian},
