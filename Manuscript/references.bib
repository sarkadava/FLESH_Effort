  date = {2020-04-03T15:52:59},
  doi = {10.31234/osf.io/2vxft},
  url = {https://psyarxiv.com/2vxft/},
  urldate = {2023-06-12},
  abstract = {The human pointing gesture may be viewed from many angles. On a basic description, it is an intentional movement, often of the hand, by which one person tries to direct another’s attention toward something; it is, in short, a bodily command to look. But this definition is only a start. Pointing may also be seen as a semiotic primitive, a philosophical puzzle, a communicative workhorse, a protean universal, a social tool, a widespread taboo, a partner of language, a part of language, a fixture of art, a graphical icon, a cognitive prop, a developmental milestone, a diagnostic window, a cross-species litmus test, and an evolutionary stepping-stone. These fifteen ways of looking at pointing highlight the diverse dimensions of one our most unassuming, ubiquitous behaviors. The gesture appears so widely, and has been treated so variously, because of what it embodies: a distinctively human preoccupation with attention.},
  langid = {american},
  pubstate = {prepublished},
  keywords = {attention,communication,gesture,pointing,reference,Social and Behavioral Sciences},
  file = {C:\Users\kadava\Zotero\storage\PPYJXDQ7\Cooperrider - 2020 - Fifteen ways of looking at a pointing gesture.pdf}
}

@article{cooperriderForegroundGestureBackground2017,
  title = {Foreground Gesture, Background Gesture},
  author = {Cooperrider, Kensy},
  date = {2017-12-31},
  journaltitle = {Gesture},
  shortjournal = {GEST},
  volume = {16},
  number = {2},
