@article{paulusEmergencePointingCommunicative2023,
  title = {The Emergence of Pointing as a Communicative Gesture: {{Age-related}} Differences in Infants’ Non-Social and Social Use of the Index Finger},
  shorttitle = {The Emergence of Pointing as a Communicative Gesture},
  author = {Paulus, Markus and Kammermeier, Marina and Melzel, Saskia},
