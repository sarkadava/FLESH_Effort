@article{charalambousNaturalAttunementShared2023,
  title = {On Natural Attunement: {{Shared}} Rhythms between the Brain and the Environment},
  shorttitle = {On Natural Attunement},
  author = {Charalambous, Efrosini and Djebbara, Zakaria},
  date = {2023-12-01},
  journaltitle = {Neuroscience \& Biobehavioral Reviews},
