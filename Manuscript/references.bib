@article{rueckertGestureEnhancesLearning2017,
  title = {Gesture Enhances Learning of a Complex Statistical Concept},
  author = {Rueckert, Linda and Church, Ruth Breckinridge and Avila, Andrea and Trejo, Theresa},
  date = {2017-01-30},
  journaltitle = {Cognitive Research: Principles and Implications},
  shortjournal = {Cogn. Research},
  volume = {2},
