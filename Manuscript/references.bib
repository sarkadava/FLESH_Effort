@article{dorCommunicationCollaborativeComputation2023,
  title = {Communication for Collaborative Computation: Two Major Transitions in Human Evolution},
  shorttitle = {Communication for Collaborative Computation},
  author = {Dor, Daniel},
  date = {2023-01-23},
  journaltitle = {Philosophical Transactions of the Royal Society B: Biological Sciences},
  volume = {378},
