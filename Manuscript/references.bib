  keywords = {expertise,kinematic,kinetic,motor variability,muscle activity,sports},
  file = {C:\Users\kadava\Zotero\storage\I469GWT4\Marineau et al. - 2024 - From Novice to Expert How Expertise Shapes Motor .pdf}
}

