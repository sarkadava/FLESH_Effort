@article{trettenbreinPsycholinguisticNormsMore2021,
  title = {Psycholinguistic Norms for More than 300 Lexical Signs in {{German Sign Language}} ({{DGS}})},
  author = {Trettenbrein, Patrick C. and Pendzich, Nina-Kristin and Cramer, Jens-Michael and Steinbach, Markus and Zaccarella, Emiliano},
  date = {2021-10-01},
  journaltitle = {Behavior Research Methods},
  shortjournal = {Behav Res},
  volume = {53},
  number = {5},
  pages = {1817--1832},
