@article{krebsEventStructureReflected2023,
  title = {Event structure reflected in muscle activation differences in Austrian Sign Language (ÖGS) verbs},
  author = {Krebs, Julia and Fessl, Isabella and Wilbur, Ronnie B. and Malaia, Evie A. and PeterWiesinger, Hans- and Schwameder, Hermann and Roehm, Dietmar},
  date = {2023-12-05},
