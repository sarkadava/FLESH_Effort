  shorttitle = {Ungrounding Symbols in Language Development},
  booktitle = {2018 {{Joint IEEE}} 8th {{International Conference}} on {{Development}} and {{Learning}} and {{Epigenetic Robotics}} ({{ICDL-EpiRob}})},
  author = {Rączaszek-Leonardi, Joanna and Deacon, Terrence W.},
  date = {2018-09},
  pages = {232--237},
  issn = {2161-9484},
  doi = {10.1109/DEVLRN.2018.8761016},
  url = {https://ieeexplore.ieee.org/document/8761016},
  urldate = {2025-04-29},
  abstract = {The relation of symbolic cognition to embodied and situated bodily dynamics remains one of the hardest problems in the contemporary cognitive sciences. In this paper we show that one of the possible factors contributing to this difficulty is the way the problem is posed. Basing on the theoretical frameworks of cognitive semiotics, ecological psychology and dynamical systems we point to an alternative way of formulating the problem and show how it suggests possible novel solutions. We illustrate the usefulness of this theoretical change in the domain of language development and draw conclusions for computational models of the emergence of symbols in natural cognition and communication as well as in artificial systems.},
  eventtitle = {2018 {{Joint IEEE}} 8th {{International Conference}} on {{Development}} and {{Learning}} and {{Epigenetic Robotics}} ({{ICDL-EpiRob}})},
  keywords = {Assistive technology,Biological system modeling,Cognition,Epistemological Foundations and Philosophical Issues,Grounding,Human-human and human-robot interaction and communication,Language acquisition,Linguistics,Robots,Semiotics}
}

