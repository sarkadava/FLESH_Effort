}

@article{stampKinematicStudyPhonetic2024,
  title = {A Kinematic Study of Phonetic Reduction in a Young Sign Language},
  author = {Stamp, Rose and Dachkovsky, Svetlana and Hel-Or, Hagit and Cohn, David and Sandler, Wendy},
  date = {2024-05-01},
  journaltitle = {Journal of Phonetics},
  shortjournal = {Journal of Phonetics},
  volume = {104},
