@article{jankeGestureSignExploration2024,
  title = {From Gesture to {{Sign}}? {{An}} Exploration of the Effects of Communicative Pressure, Interaction, and Time on the Process of Conventionalisation},
  shorttitle = {From Gesture to {{Sign}}?},
  author = {Janke, Vikki and Aumônier, Lizzy and Hofweber, Julia and Gullberg, Marianne and Marshall, Chloë},
