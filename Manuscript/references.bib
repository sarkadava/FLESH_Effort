@book{mangalamEmbodiedMindFallacy2025,
  title = {The Embodied Mind Fallacy},
  author = {Mangalam, Madhur},
  date = {2025-08-21},
  abstract = {Embodied cognition was hailed as a paradigm shift—promising to overcome the mind–body dualism entrenched in traditional cognitive science by grounding thought in bodily experience and sensorimotor interaction. Yet, this paper argues that most contemporary embodied cognition theories ultimately fail to deliver on that promise. Instead of breaking free from computationalism, they quietly reproduce it. The body is too often cast as a mere input device feeding a central processor, preserving the very homuncular architectures and representational logics they claim to transcend. Most critically, embodied cognition has systematically ignored the fluid, cross-scale metabolic dynamics that constitute genuine embodiment. Cognition emerges from the continuous coordination of energy flows cascading across molecular, cellular, neural, and behavioral scales simultaneously—from glucose availability shaping decision quality to circadian rhythms modulating attention, from gut microbiome composition influencing neural development to muscle fatigue reorganizing affordance perception. These are not peripheral implementation details but the very substance of cognitive process itself. When we think, every cell participates; when we perceive, metabolic gradients reorganize; when we act, energetic flows cascade across scales in ways that computational metaphors operating at any single level cannot capture. We contend that embodied cognition's radical veneer conceals a deep conservatism: it retains the explanatory scaffolding of classical cognitive science while merely shifting symbols from abstract manipulation to sensorimotor domains. This critique extends to enactivism, sensorimotor contingency theory, and grounded cognition, all of which remain tethered to computational metaphors beneath their embodied rhetoric. Genuine embodiment requires abandoning computation altogether in favor of ecological and dynamical frameworks that treat mind, body, and environment as a single system of energetic constraint and cross-scale metabolic coordination. By exposing the embodied mind fallacy, we aim to redirect cognitive science toward truly post-computational terrain—beyond the persistent ghost of the Cartesian theater and toward the fluid dynamics of living systems.},
  file = {C:\Users\kadava\Zotero\storage\XKHPHNMK\Mangalam - 2025 - The embodied mind fallacy.pdf}
}

@article{mangalamHowBigAction2026,
  title = {How Big Is an Action?},
  author = {Mangalam, Madhur},
  date = {2026-02-26},
  abstract = {Where does an action reside? When we reach for a cup of coffee, is the action in the hand, the arm, the anticipatory postural adjustments rippling through the legs, the visual guidance from the eyes, or the neural activity spanning cortex to spinal cord? Movement science has long sought to localize control—to identify the privileged scale or anatomical locus where action is specified. Yet physiological evidence increasingly suggests that this localization may be fundamentally intractable. From ion channels operating on microsecond timescales to developmental changes unfolding across years, from molecular motors to whole-body coordination with the environment, movement cascades across spatial and temporal scales in ways that resist decomposition. Here, we explore this intractability not as a problem to be solved but as an invitation to reimagine what movement is. Drawing on examples from atmospheric physics to cellular physiology, we ask whether the search for a locus of control has been misguided—whether movement, like weather, is an inherently multiscale phenomenon that cannot be pinned to any single level of organization. We advance this argument through three linked claims: that the localization problem reflects a category error (action as coupling-pattern rather than localizable property), that scale-dependence is tied explicitly to measurement operations (temporal windows, spatial aggregation, coordinate choice partly constitute observed boundaries), and that abandoning the search for control loci carries concrete commitments for experimental design and theoretical interpretation. Rather than offering solutions, we trace the contours of this mystery, revealing how it challenges foundational assumptions in motor control, cognitive neuroscience, and theories of embodied cognition.},
  file = {C:\Users\kadava\Zotero\storage\9MGBUUMK\Mangalam - 2026 - How big is an action.pdf}
}

@article{mangalamIllusionInternalModels2025,
  title = {The Illusion of Internal Models in Biological Movement},
  author = {Mangalam, Madhur},
  date = {2025-08-27},
  journaltitle = {European Journal of Applied Physiology},
  shortjournal = {European Journal of Applied Physiology},
  volume = {125},
  pages = {3083--3114},
  doi = {10.1007/s00421-025-05963-3},
  abstract = {The concept of internal models dominates contemporary theories of sensorimotor control, with researchers across neurosciences, specifically motor control, routinely explaining observed behaviors through computational representations that supposedly exist within the nervous system. In this perspective, I present a critical examination of internal model frameworks in sensorimotor control. I argue that representational approaches mischaracterize biological systems for several fundamental reasons: (1) Internal models require homuncular interpreters, creating infinite regress problems; (2) The purported neural implementations of internal models remain empirically elusive despite decades of research; (3) Biological movement systems exhibit multiscale, nonlinear, and non-Gaussian dynamics that fundamentally defy reduction to conventional computational representations; (4) Internal model frameworks implicitly depend on Cartesian dualism through their separation of the “controller” and “controlled;” (5) The framework is methodologically circular and largely unfalsifiable as virtually any behavior can be retroactively modeled as implementing some internal representation; and (6) Alternative frameworks based on ecological dynamics and self-organization can account for adaptive behavior without invoking representational assumptions. Instead of representational models, I propose that sensorimotor control emerges from the dynamic coupling between the organism and the environment across multiple spatial and temporal scales. By moving beyond the internal model paradigm, sensorimotor neuroscience can develop more powerful explanatory frameworks that better capture the emergent, context-sensitive properties of biological movement without invoking physiologically intractable computational metaphors.},
  file = {C:\Users\kadava\Zotero\storage\SKQWTDLD\Mangalam - 2025 - The illusion of internal models in biological movement.pdf}
}

@article{mangalamTemporalOrganizationStridetostride24.8.2023,
  title = {Temporal Organization of Stride-to-Stride Variations Contradicts Predictive Models for Sensorimotor Control of Footfalls during Walking},
