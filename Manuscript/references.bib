  keywords = {Iconic Gesture,Representational Gesture,Spatial Concept,Speech Content,Video Instruction}
}

@article{ruiterExploringCognitiveInfrastructure2010,
  title = {Exploring the Cognitive Infrastructure of Communication},
  author = {family=Ruiter, given=Jan Peter, prefix=de, useprefix=false and Noordzij, Matthijs L. and Newman-Norlund, Sarah and Newman-Norlund, Roger and Hagoort, Peter and Levinson, Stephen C. and Toni, Ivan},
